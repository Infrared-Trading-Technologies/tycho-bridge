*~
.directory
.Trash-*

# =============================================================================
# Testing & Coverage
# =============================================================================

# Rust coverage (cargo-llvm-cov, tarpaulin)
lcov.info
*.lcov
coverage/
htmlcov/
tarpaulin-report.html
cobertura.xml

# Go coverage
cover.out
c.out

# Test results
test-results/
junit.xml
test-report.xml

# =============================================================================
# Documentation
# =============================================================================

# Generated documentation
/doc/
target/doc/

# mdBook output
book/

# =============================================================================
# Build Tools & Caches
# =============================================================================

# Cargo caches (usually in ~/.cargo, but just in case)
.cargo/

# sccache
.sccache/

# Node (if using any JS tooling)
node_modules/
npm-debug.log
yarn-error.log

# Python (if using any Python tooling)
__pycache__/
*.py[cod]
.pytest_cache/
*.egg-info/
venv/
.venv/

# =============================================================================
# Logs & Debug
# =============================================================================

# Log files
*.log
logs/
*.log.*

# Debug files
*.dSYM/
*.su
*.idb

# Core dumps
core
core.*

# =============================================================================
# Miscellaneous
# =============================================================================

# Temporary files
*.tmp
*.temp
*.bak
*.backup

# Archives (usually not source)
*.zip
*.tar
*.tar.gz
*.tgz
*.rar
*.7z

# Database files
*.db
*.sqlite
*.sqlite3

# Claude Code
.claude/

