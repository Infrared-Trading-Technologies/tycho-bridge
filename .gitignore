# =============================================================================
# Rust
# =============================================================================

# Build directory
/target/
**/target/

# Cargo lock file in libraries (keep for binaries/workspaces)
# Cargo.lock  # We keep this for reproducible builds

# Backup files generated by rustfmt
**/*.rs.bk

# MSVC Windows builds
*.pdb

# Profiling data
*.profraw
*.profdata

# =============================================================================
# Go
# =============================================================================

# Binaries (Go builds without extension on Unix)
clients/go-ffi/examples/*/main
clients/go-ffi/examples/*/*.exe
clients/go/examples/*/main
clients/go/examples/*/*.exe
clients/go/basic_example
clients/go-ffi/basic_example

# Common binary extensions
*.exe
*.exe~

# Test binary, built with `go test -c`
*.test

# Output of the go coverage tool
*.out
coverage.html
coverage.txt

# Go workspace file
go.work
go.work.sum

# Vendor directory (if not committing dependencies)
# vendor/

# =============================================================================
# FFI / C
# =============================================================================

# Generated C headers (keep include/ but ignore if regenerated elsewhere)
# /include/  # We keep this for distribution

# Shared libraries (platform-specific)
*.a
lib*.so
lib*.so.*
lib*.dylib
*.dll

# Object files
*.o
*.obj

# =============================================================================
# Protocol Buffers
# =============================================================================

# Generated protobuf code (Go)
# clients/go/gen/  # We keep generated code for Go client distribution

# Generated protobuf code (Rust) - handled by build.rs, stored in target/
# These are auto-generated and shouldn't be committed

# =============================================================================
# Environment & Secrets
# =============================================================================

# Environment files (may contain API keys, secrets)
.env
.env.*
!.env.example
.envrc

# Secret files
*.pem
*.key
*.crt
*.p12
*.pfx
credentials.json
secrets.json
**/secrets/

# =============================================================================
