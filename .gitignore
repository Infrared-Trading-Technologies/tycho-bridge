# =============================================================================

# VS Code
.vscode/
*.code-workspace

# JetBrains (IntelliJ, CLion, GoLand, RustRover)
.idea/
*.iml
*.ipr
*.iws

# Vim
*.swp
*.swo
*~
.*.swp

# Emacs
*~
\#*\#
.#*

# Sublime Text
*.sublime-project
*.sublime-workspace

# =============================================================================
