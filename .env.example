# Tycho Bridge Configuration
# Copy this file to .env and fill in the required values.
# 
# NOTE: All configuration is read from environment variables following 12-factor principles.
# Never commit actual secrets to version control.

# =============================================================================
# REQUIRED - Tycho Connection
# =============================================================================

# WebSocket URL for Tycho indexer
TYCHO_URL=wss://tycho-beta.propellerheads.xyz

# API key for authenticating with Tycho service
TYCHO_API_KEY=your-api-key-here

# =============================================================================
# OPTIONAL - Server Configuration
# =============================================================================

# gRPC server bind address (default: 0.0.0.0)
# GRPC_HOST=0.0.0.0

# gRPC server port (default: 50051)
# GRPC_PORT=50051

# Prometheus metrics port (default: 9000)
# Metrics endpoint: http://0.0.0.0:9000/metrics
# METRICS_PORT=9000

# Comma-separated list of chain IDs to sync
# 1 = Ethereum, 8453 = Base, 130 = Unichain
# CHAIN_IDS=1,8453,130

# =============================================================================
# OPTIONAL - Logging
# =============================================================================

# Log level filter (default: info)
# Examples: debug, info, warn, error
# For fine-grained control: tycho_bridge=debug,info
# RUST_LOG=info
